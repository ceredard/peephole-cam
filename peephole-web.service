[Unit]
Description=Peephole camera web viewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cred
WorkingDirectory=/home/cred/peephole-cam
# Contains PEEPHOLE_PASSWORD=... (and optionally PEEPHOLE_USER=...)
EnvironmentFile=/home/cred/peephole-cam/web.env
ExecStart=/usr/bin/python3 /home/cred/peephole-cam/web_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
